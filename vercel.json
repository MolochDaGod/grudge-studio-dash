{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo skip",
  "buildCommand": "echo skip",
  "outputDirectory": "dist",
  "framework": null,
  "regions": ["iad1"],
  "redirects": [
    { "source": "/play", "destination": "https://play.grudge-studio.com/", "permanent": true },
    { "source": "/play/:path*", "destination": "https://play.grudge-studio.com/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.grudge-studio.com/api/:path*" },
    { "source": "/assets-cdn/:path*", "destination": "https://assets.grudge-studio.com/:path*" },
    { "source": "/((?!api/|assets-cdn/|assets/|favicon|robots\\.txt|manifest|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}